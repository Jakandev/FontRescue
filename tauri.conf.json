{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FontRescue",
  "version": "0.1.0",
  "identifier": "com.fontrescue.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FontRescue",
        "width": 420,
        "height": 640,
        "resizable": true,
        "minWidth": 380,
        "minHeight": 320,
        "visible": false,
        "center": true,
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "shortDescription": "Installs the fonts your projects need",
    "longDescription": "Watches After Effects and Premiere, installs missing fonts from your own archive, and tells you to reopen the project."
  }
}
